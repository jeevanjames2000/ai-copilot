# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables (Protect your API Key)
.env
.env.local
.env.*.local

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE Settings
.vscode/
.idea/
*.swp
*.swo

# Build output (electron-builder writes here)
dist/
out/
release/
.cache/

# NOTE: build/ is deliberately NOT ignored — it holds the app icons
# (build/icon.icns, build/icon.ico, build/icon.png) that electron-builder
# needs. Git cannot re-include files under an ignored directory, so this
# entry must stay removed or CI will produce unbranded builds.

# Electron
*.log

# Scripts
*.bat

# Legacy Folders (From previous refactoring)
_legacy_client/
_legacy_server/
client/
server/
