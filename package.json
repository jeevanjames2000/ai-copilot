{
  "name": "ai-copilot-desktop",
  "version": "1.1.3",
  "description": "AI Copilot - Stealth AI Assistant",
  "author": {
    "name": "Jeevan Sekhar Tamada",
    "email": "jeevanjames2000@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.jeevan.ai-copilot",
    "productName": "AI Copilot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "main.js",
      "ModelRegistry.js",
      "preload.js",
      "index.html",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/{test,__tests__,tests,powered-test,example,examples}/**",
      "!node_modules/**/*.{md,markdown,map}",
      "!node_modules/**/{.bin,.github,docs}/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": 1,
        "NSMicrophoneUsageDescription": "AI Copilot records audio when you use the mic button to ask a question.",
        "NSScreenCaptureUsageDescription": "AI Copilot captures your screen when you press the screenshot shortcut."
      },
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Copilot"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Jeevan Sekhar Tamada <jeevanjames2000@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "highlight.js": "^11.9.0",
    "node-fetch": "^3.3.2",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3"
  }
}
